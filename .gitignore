# Whitelist: only the built site and the deploy workflow are published.
# build.js, generate.js, site.config.js, content/, _src, _source and the raw client
# photographs stay local (the site-security gate flags them as S1 if served or public).
*
!.gitignore
!.github/
!.github/**
!index.html
!_site/
!_site/**
